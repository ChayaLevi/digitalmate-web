# DigitalMate Web configuration
# Copy to .env.local for Vite, or export in the shell / compose before
# `npm run dev`, `npm run preview` or `npm run start`.
# Without Orbit values the app stays on the fully local, account-free mock.

# ---------------------------------------------------------------------------
# Bridge server (services/bridge, Docker)
# ---------------------------------------------------------------------------
# Bind address and port for the standalone static + API server.
# HOST=127.0.0.1
# PORT=4173

# ---------------------------------------------------------------------------
# Orbit gateway (optional)
# ---------------------------------------------------------------------------
# Jiuwen/Orbit gateway WebSocket endpoint. wss:// is required.
ORBIT_GATEWAY_URL=wss://gateway.example.com/orbit/ws?binding_id=default

# Prefer a token file outside the repository. Never commit a real token.
# Mount it read-only into the container when self-hosting.
# ORBIT_TOKEN_FILE=/absolute/path/to/orbit-token

# Temporary local testing only.
# ORBIT_TOKEN=

# Optional Agent DX binding override.
# ORBIT_BINDING_ID=default

# Only for a local/self-hosted plain-ws gateway. Keep unset for production.
# ORBIT_ALLOW_INSECURE_WS=1

# Extra origins allowed to call the bridge. Same-origin requests are always
# allowed. Add the exact origins used by separately hosted or native clients,
# for example the Capacitor shell. Comma-separated; no trailing slash.
# Use "null" only if you deliberately support file:// clients.
# ORBIT_ALLOWED_ORIGINS=https://localhost,https://app.example.com

# ---------------------------------------------------------------------------
# Static/native API base
# ---------------------------------------------------------------------------
# Optional absolute API base for static/native builds (RSS + Orbit endpoints).
# Leave empty for same-origin hosting.
# VITE_API_BASE=https://bridge.example.com

# GitHub Pages build only.
# VITE_BASE=/digitalmate-web/

# ---------------------------------------------------------------------------
# Epic Replay (Labs > Epic Replay)
# ---------------------------------------------------------------------------
# The Epic Replay server the bridge talks to. Keep it on localhost or behind
# your own authenticated proxy: Epic Replay has no login of its own.
# EPIC_REPLAY_URL=http://127.0.0.1:8010
# Only if a proxy in front of Epic Replay expects a Bearer token. Server-side only.
# EPIC_REPLAY_TOKEN=

# ---------------------------------------------------------------------------
# Fridge2Table (Kitchen companion, and kitchen questions in any chat)
# ---------------------------------------------------------------------------
# The Fridge2Table server the bridge talks to. Server-side only.
# FRIDGE2TABLE_URL=https://fridge-to-table.onrender.com
# Pin every browser to one Fridge2Table household (the 32-hex `household` cookie of a browser that
# already has the demo kitchen). Leave empty so each browser gets its own kitchen.
# FRIDGE2TABLE_HOUSEHOLD=
# How long a chat turn may take (ms). Render can need up to a minute to wake up.
# FRIDGE2TABLE_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Homemind (Family tab). Off unless HOMEMIND_ENABLED=1. See docs/PLAN.md.
# ---------------------------------------------------------------------------
# HOMEMIND_ENABLED=1
# Signs demo session tokens. Required when enabled. Never commit a real value.
# HOMEMIND_SECRET=
# Demo-only routes: clock jump, reset, ?member= pre-select, debug state.
# HOMEMIND_DEMO=1
# 1 logs each LLM/PPMA call (no keys, no message text); 2 also logs message text.
# HOMEMIND_DEBUG=0
# HOMEMIND_DATA_FILE=.homemind/state.json
# live, or fake to run with canned replies and no key.
# HOMEMIND_LLM=fake
# OpenAI-compatible endpoint. Server-side only.
# HOMEMIND_LLM_BASE_URL=
# HOMEMIND_LLM_API_KEY=
# HOMEMIND_LLM_MODEL=
# Per model call, 1000 to 120000 ms (default 30000).
# HOMEMIND_LLM_TIMEOUT_MS=30000
# To test the live client without a key: npm run llm:fake, then
# HOMEMIND_LLM=live HOMEMIND_LLM_BASE_URL=http://127.0.0.1:8031/v1 HOMEMIND_LLM_MODEL=fake
# PPMA (long-term memory). Server-side only.
# PPMA_URL=http://127.0.0.1:8765
# Prefer a token file outside the repository.
# PPMA_OWNER_TOKEN_FILE=
# PPMA_OWNER_TOKEN=
# PPMA_SPACE=me
# Timeout per PPMA call in ms (1000 to 60000). The stream is long-lived and checked by heartbeat instead.
# PPMA_TIMEOUT_MS=10000
# Without PPMA: `node scripts/fake-ppma.mjs` (simulated, port 18766) and its printed PPMA_URL / owner token.
